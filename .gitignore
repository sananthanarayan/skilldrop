# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp
*~

# Python (for the figma-diagrams skill scripts)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/

# Local secrets — never commit
.env
.env.local
*.figmatoken

# Generated catalogue site (RFC-0011) — built by CI, never committed
build/

# Generated agentbundle-schema catalogue (RFC-0014) — built by build_catalogue.py,
# published to the agentbundle-catalogue branch; never committed to main
dist/

# Test renders / scratch output
out/
renders/
*.png
*.svg
*.pdf
!skills/**/examples/**/*.png
!skills/**/examples/**/*.svg
# …and the committed site assets. og.png is rendered once from assets/og.svg with
# rsvg-convert and committed, so build_site.py stays stdlib-only (RFC-0011).
!assets/*.svg
!assets/*.png

# Claude local state
.claude/settings.local.json

# agent tooling scratch (attachments, session state) — never repo content
.context/
