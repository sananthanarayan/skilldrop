name: release

on:
  push:
    tags: ["v*"]

permissions:
  contents: write
  id-token: write

jobs:
  publish:
    runs-on: [self-hosted, linux, release]
    environment: production
    steps:
      - uses: actions/checkout@9ce6fd9fa4b164bf8911b62115bf9104ba1a2803 # v4.2.0
      - uses: bramblewick/setup-toolchain@c8aee2ae521bdb1ef1b97761673ebbe92c953b0f # v3.2.0
        with:
          node-version-file: .nvmrc
      - run: npm ci
      - run: npm run build
      - run: npm run release
        env:
          RELEASE_SIGNING_KEY: ${{ secrets.RELEASE_SIGNING_KEY }}
          NPM_TOKEN: ${{ secrets.NPM_TOKEN }}
