{
  "name": "wayline-board",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "build": "tsc -p .",
    "test": "jest --coverage"
  },
  "jest": {
    "preset": "ts-jest",
    "testMatch": ["**/src/**/*.test.ts"],
    "coverageDirectory": "coverage",
    "coverageReporters": ["lcov", "text-summary"]
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
