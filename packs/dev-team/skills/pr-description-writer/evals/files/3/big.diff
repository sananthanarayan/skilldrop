diff --git a/jobs/archive.py b/jobs/archive.py
new file mode 100644
--- /dev/null
+++ b/jobs/archive.py
@@ -0,0 +1,14 @@
+import os
+from datetime import datetime, timedelta, timezone
+
+from models import Order
+
+ARCHIVE_DAYS = int(os.environ["ORDERS_ARCHIVE_DAYS"])
+
+
+def archive_old_orders(db):
+    cutoff = datetime.now(timezone.utc) - timedelta(days=ARCHIVE_DAYS)
+    n = db.query(Order).filter(Order.closed_at < cutoff, Order.archived_at.is_(None)).update(
+        {"archived_at": datetime.now(timezone.utc)})
+    db.commit()
+    return n
