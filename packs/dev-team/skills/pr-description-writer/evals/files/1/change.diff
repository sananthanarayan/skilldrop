@@ -1,14 +1,27 @@
 import logging
+import time

 import requests

 log = logging.getLogger(__name__)
+MAX_ATTEMPTS = 4
+BACKOFF_SECONDS = (1, 4, 16)


 def deliver(url, payload):
-    resp = requests.post(url, json=payload, timeout=5)
-    if resp.status_code >= 400:
-        log.warning("delivery failed: %s", resp.status_code)
-        return False
-    return True
+    for attempt in range(1, MAX_ATTEMPTS + 1):
+        resp = requests.post(url, json=payload, timeout=5)
+        if resp.status_code < 400:
+            return True
+        if resp.status_code < 500:
+            log.warning("delivery rejected: %s", resp.status_code)
+            return False
+        log.warning("delivery failed (attempt %d): %s", attempt, resp.status_code)
+        if attempt < MAX_ATTEMPTS:
+            time.sleep(BACKOFF_SECONDS[attempt - 1])
+    return False
