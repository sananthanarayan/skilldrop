{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(**)",
      "Edit(CHANGELOG.md)",
      "Bash(git checkout -b changelog/*)",
      "Bash(git add CHANGELOG.md)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr create:*)",
      "Bash(gh api:*)",
      "Bash(curl:*)",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "env": {
    "CHANGELOG_WINDOW_DAYS": "7"
  }
}
