{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_EXAMPLEEXAMPLEEXAMPLEEXAMPLE0000"
      }
    },
    "web-reader": {
      "command": "npx",
      "args": ["-y", "fetch-anything-mcp@latest"]
    },
    "dispatch-db": {
      "command": "npx",
      "args": ["-y", "@larkspur/pg-mcp@2.3.1", "--read-only"],
      "env": {
        "DATABASE_URL": "${DISPATCH_RO_DB_URL}"
      }
    }
  }
}
